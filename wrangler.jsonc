{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "gasak-kalo-iya",
  "main": "_worker.js",
  "compatibility_date": "2026-10-07",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true,
    "exclude": [
      "_worker.js",
      "wrangler.jsonc",
      "schema.sql",
      "README.md",
      ".assetsignore"
    ]
  }
}